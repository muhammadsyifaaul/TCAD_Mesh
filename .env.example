# ─────────────────────────────────────────────────────────────
# TCAD Mesh — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Shared Internal Secret (used by gateway → control-api writes) ──
INTERNAL_KEY=change-me-to-a-random-32-char-string

# ── Gateway ────────────────────────────────────────────────────────
UPSTREAM_URL=http://target-app:8001
HONEYPOT_URL=http://honeypot:8002
CONTROL_URL=http://control-api:8003

# Canary paths (comma-separated, no spaces)
CANARY_PATHS=/admin,/api/v1/ops/deploy,/.env,/backup

# Honeytoken poll interval (ms) — controls the blind window
HONEYTOKEN_POLL_MS=500

# Enumeration detection
ENUM_THRESHOLD=5
ENUM_WINDOW_SEC=10

# Tarpit
TARPIT_DELAY_MS=3000
TARPIT_MAX_CONCURRENT=50

# Quarantine TTL
QUARANTINE_TTL_SEC=900

# Mode 2 (disabled by default — do NOT enable until Tier 5)
MODE2_ENABLED=false
MODE2_INTERVAL_SEC=60
MODE2_GRACE=2
MODE2_STRICT=true
MODE2_SECRET=change-me-mode2-hmac-secret

# ── Honeypot ───────────────────────────────────────────────────────
# Secret used to seed deterministic fake data per identity
HONEYPOT_SECRET=change-me-to-another-random-secret

# ── Dashboard ──────────────────────────────────────────────────────
# VITE_API_BASE is not needed — nginx proxies all /stats /events /sim etc.
# INTERNAL_KEY (above) is injected by nginx at runtime via envsubst; never in JS.
VITE_API_BASE=

# ── Redis (Mode 2 only) ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
